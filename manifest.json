{
  "manifest_version": 3,
  "name": "Notion Math Converter",
  "version": "1.0",
  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
  },
  "description": "Converts LaTeX-style math equations to Notion's native format.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://www.notion.so/*"],
  "content_scripts": [
    {
      "matches": ["https://www.notion.so/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Convert Notion equations",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
