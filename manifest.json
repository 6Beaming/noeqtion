{
  "manifest_version": 3,
  "name": "Notion Math Converter",
  "version": "1.0",
  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
  },
  "description": "Converts LaTeX-style math equations to Notion's native format.\n Cloned from https://github.com/zouyujht/noeqtion",
  "permissions": ["activeTab", "scripting"],
    "host_permissions": [
    "https://*.notion.so/*",
    "https://*.notion.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.notion.so/*",
        "https://*.notion.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Convert Notion equations",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
